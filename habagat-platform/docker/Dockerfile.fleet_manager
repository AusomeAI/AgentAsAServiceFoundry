# Fleet Manager Service — Doc 51 §1.2.
FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY controlplane/fleet_manager/ ./controlplane/fleet_manager/
COPY controlplane/shared/ ./controlplane/shared/
EXPOSE 8080
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/healthz')"
CMD ["python", "-m", "controlplane.fleet_manager.health"]
