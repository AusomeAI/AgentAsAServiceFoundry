# Provisioning Engine — Doc 51 §1.2. Bundles the Terraform CLI since this
# service is the only one that ever invokes `terraform apply`/`destroy`
# (Doc 32 §3.1's "no out-of-band apply" rule — this is the ONE in-band path).
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip \
    && curl -fsSL -o /tmp/tf.zip https://releases.hashicorp.com/terraform/1.7.5/terraform_1.7.5_linux_amd64.zip \
    && unzip /tmp/tf.zip -d /usr/local/bin \
    && rm /tmp/tf.zip \
    && apt-get purge -y unzip && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY controlplane/provisioning_engine/ ./controlplane/provisioning_engine/
COPY controlplane/shared/ ./controlplane/shared/
COPY infra/ ./infra/
EXPOSE 8080
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/healthz')"
CMD ["python", "-m", "controlplane.provisioning_engine.health"]
