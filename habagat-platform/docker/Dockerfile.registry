# Blueprint Registry Service — Doc 51 §1.2's control-plane deployable.
FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY spec/ ./spec/
COPY compiler/ ./compiler/
COPY controlplane/registry/ ./controlplane/registry/
COPY controlplane/shared/ ./controlplane/shared/
EXPOSE 8080
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/healthz')"
CMD ["python", "-m", "controlplane.registry.health"]
